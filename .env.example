# Global
SANDBOX_MODE=true
JWT_SECRET=change-me
DEFAULT_TENANT_NAME=Demo Realty Columbus

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=realtor_copilot
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/realtor_copilot

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENFORCE_GLOBAL_REVOCATION=false

# Public source defaults
FRANKLIN_AUDITOR_BASE_URL=https://audr-api.franklincountyohio.gov/
FRANKLIN_AUDITOR_PATH_BY_ADDRESS=/v1/parcels/ByAddress
FRANKLIN_AUDITOR_PATH_BY_PARCEL=/v1/parcels/ByParcelNumber
COLUMBUS_ARCGIS_BASE_URL=https://services5.arcgis.com/54falWtcpty3V47Z/ArcGIS/rest/services/
COLUMBUS_PERMITS_LAYER_PATH=
COLUMBUS_CODE_LAYER_PATH=
FEMA_NFHL_ARCGIS_URL=
GTFS_URL=
OVERPASS_URL=https://overpass-api.de/api/interpreter
ENABLE_MLS_SYNC=false

# Outreach providers (only used when SANDBOX_MODE=false)
POSTMARK_SERVER_TOKEN=
POSTMARK_SENDER_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=/api/proxy
NEXT_PUBLIC_ENABLE_SW=false
API_INTERNAL_URL=http://api:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-nextauth
DEMO_USER_EMAIL=agent@demo.local
DEMO_USER_PASSWORD=demo123

# Mobile (Expo)
# iOS simulator: http://localhost:8000
# Physical device: use your LAN IP, e.g. http://192.168.1.22:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
