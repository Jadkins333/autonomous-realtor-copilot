{
  "name": "autonomous-realtor-intel-copilot",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "doctor": "bash scripts/doctor.sh",
    "demo": "bash scripts/demo.sh",
    "dev:web": "pnpm --filter web dev",
